<mxfile host="app.diagrams.net"><diagram name="Fig1 T-DPC-RWA workflow"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" page="1" pageWidth="827" pageHeight="1169"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="req" value="Stochastic connection request r = (s, d, type)&lt;br&gt;Poisson arrivals, exponential holding times" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="0" width="520" height="60" as="geometry"/></mxCell><mxCell id="cls" value="Classical request:&lt;br&gt;k candidate paths ranked by quantum-overlap cost; first-fit wavelength" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="340" height="70" as="geometry"/></mxCell><mxCell id="qnt" value="Quantum request:&lt;br&gt;direct O-band lightpath; test QSNR ≥ Γ_Q + ε" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="340" height="70" as="geometry"/></mxCell><mxCell id="aux" value="Layered auxiliary graph&lt;br&gt;conversion edges only at sparse O-E-O hubs (high betweenness)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="340" height="70" as="geometry"/></mxCell><mxCell id="rel" value="Trusted-relay chain s → r1 → … → d&lt;br&gt;keep the chain with the highest bottleneck SKR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="240" width="340" height="70" as="geometry"/></mxCell><mxCell id="adm" value="Admission: all active quantum channels keep QSNR ≥ Γ_Q + ε&lt;br&gt;launch power P = P_min(1 + m0); update network state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="370" width="520" height="70" as="geometry"/></mxCell><mxCell id="tel" value="SDN telemetry poll every Δt&lt;br&gt;QSNR_q, SNR_c,s, excess loss η_c,s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="490" width="520" height="60" as="geometry"/></mxCell><mxCell id="risk" value="At-risk channel:&lt;br&gt;compute noise reduction ΔN* and headroom H" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="610" width="340" height="60" as="geometry"/></mxCell><mxCell id="rec" value="Hysteresis recovery:&lt;br&gt;raise throttled powers by Δp towards P_min(1 + m0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="610" width="340" height="60" as="geometry"/></mxCell><mxCell id="l1" value="Level 1 (H ≥ ΔN*):&lt;br&gt;sensitivity-ordered power throttling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="720" width="340" height="60" as="geometry"/></mxCell><mxCell id="l2" value="Level 2:&lt;br&gt;make-before-break re-grooming of the dominant interferer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#404040;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="720" width="340" height="60" as="geometry"/></mxCell><mxCell id="e0" value="classical" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="req" target="cls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="quantum" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="req" target="qnt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="no continuous free wavelength" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="cls" target="aux"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="reach or QSNR test fails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="qnt" target="rel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="path found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="cls" target="adm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="feasible" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="qnt" target="adm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="aux" target="adm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="rel" target="adm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="adm" target="tel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="QSNR &lt; Γ_Q + ε" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="tel" target="risk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="QSNR ≥ Γ_Q + ε + h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="tel" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="H ≥ ΔN*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="risk" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="H &lt; ΔN*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="risk" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="still at risk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="next Δt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="l1" target="tel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="next Δt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="l2" target="tel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="next Δt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="rec" target="tel"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
